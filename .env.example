# Copie este arquivo para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env — ele está no .gitignore.

# Escolhe qual bloco de credenciais abaixo o backend vai usar:
#   prod  -> banco de produção
#   dev   -> banco de homologação
#   local -> Postgres rodando na sua máquina
APP_ENV=local

# ---- Produção ----
PROD_TYPEORM_HOST=
PROD_TYPEORM_PORT=5432
PROD_TYPEORM_USERNAME=
PROD_TYPEORM_PASSWORD=
PROD_TYPEORM_DATABASE=

# ---- Homologação ----
DEV_TYPEORM_HOST=
DEV_TYPEORM_PORT=6543
DEV_TYPEORM_USERNAME=
DEV_TYPEORM_PASSWORD=
DEV_TYPEORM_DATABASE=

# ---- Local ----
LOCAL_TYPEORM_HOST=localhost
LOCAL_TYPEORM_PORT=5432
LOCAL_TYPEORM_USERNAME=postgres
LOCAL_TYPEORM_PASSWORD=
LOCAL_TYPEORM_DATABASE=

TYPEORM_MIGRATIONS=src/database/migrations/*.ts
TYPEORM_MIGRATIONS_DIR=src/database/migrations

# Segredo usado para assinar/validar os tokens JWT (gere um valor aleatório longo)
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Validade do token quando o usuário faz login SEM marcar "Lembrar de mim"
JWT_EXPIRES_IN_SEM_LEMBRAR=12h

# Client ID do OAuth do Google (Google Cloud Console > Credenciais). Mesmo
# valor em todos os ambientes (local/dev/prod) — não é segredo, o mesmo
# valor também vai no .env do frontend (VITE_GOOGLE_CLIENT_ID).
GOOGLE_CLIENT_ID=

# Resend (envio do e-mail de recuperação de senha). Crie uma API Key em
# resend.com/api-keys. Sem verificar um domínio próprio, EMAIL_FROM precisa
# ser algo como "NotePlus+ <onboarding@resend.dev>" (domínio de teste do
# Resend) — nesse modo, o Resend só entrega para o e-mail da conta que criou
# a API Key. Pra mandar pra qualquer destinatário, verifique um domínio em
# resend.com/domains e use um remetente desse domínio.
RESEND_API_KEY=
EMAIL_FROM=

# URL do frontend, usada para montar o link de redefinição de senha
# (ex.: http://localhost:5173/redefinir-senha?token=...).
FRONTEND_URL=http://localhost:5173

# Origens (URLs do frontend) autorizadas a chamar essa API pelo navegador
# (CORS). Separe por vírgula se precisar de mais de uma (ex.: local +
# homologação). Sem essa variável, o backend só libera localhost:5173 —
# NUNCA deixe em branco/"*" em produção.
CORS_ORIGINS=http://localhost:5173
